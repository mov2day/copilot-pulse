{
  "name": "copilot-pulse",
  "displayName": "Copilot Pulse",
  "description": "Calm, local-first GitHub Copilot AI-credit awareness for VS Code.",
  "version": "0.1.0",
  "publisher": "MuthuKumarKoodalingam",
  "repository": { "type": "git", "url": "https://github.com/mov2day/copilot-pulse.git" },
  "license": "MIT",
  "engines": { "vscode": "^1.96.0" },
  "categories": ["Other", "Visualization"],
  "keywords": ["copilot", "usage", "budget", "ai credits", "forecast"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "copilotPulse.openDashboard", "title": "Copilot Pulse: Open Dashboard" },
      { "command": "copilotPulse.startSession", "title": "Copilot Pulse: Start Focus Session" },
      { "command": "copilotPulse.endSession", "title": "Copilot Pulse: End Focus Session" },
      { "command": "copilotPulse.enterSnapshot", "title": "Copilot Pulse: Enter Usage Snapshot" },
      { "command": "copilotPulse.importReport", "title": "Copilot Pulse: Import Usage Report" },
      { "command": "copilotPulse.refresh", "title": "Copilot Pulse: Refresh Usage" },
      { "command": "copilotPulse.connectPersonalApi", "title": "Copilot Pulse: Connect Personal Usage API" },
      { "command": "copilotPulse.enableEconomy", "title": "Copilot Pulse: Enable Economy Mode" },
      { "command": "copilotPulse.snooze", "title": "Copilot Pulse: Snooze Alerts" },
      { "command": "copilotPulse.configureBudgets", "title": "Copilot Pulse: Configure Budgets" },
      { "command": "copilotPulse.explainAlert", "title": "Copilot Pulse: Explain Current Alert" },
      { "command": "copilotPulse.exportHistory", "title": "Copilot Pulse: Export Local History" },
      { "command": "copilotPulse.deleteHistory", "title": "Copilot Pulse: Delete Local History" }
    ],
    "configuration": {
      "title": "Copilot Pulse",
      "properties": {
        "copilotPulse.enabled": { "type": "boolean", "default": true },
        "copilotPulse.dataSource": { "type": "string", "enum": ["auto", "personal-api", "manual", "import", "organization-report", "enterprise-report", "enterprise-records"], "default": "auto" },
        "copilotPulse.budgets.daily": { "type": "number", "minimum": 0, "default": 80, "description": "Your personal daily planning target; not a Copilot plan allowance." },
        "copilotPulse.budgets.weekly": { "type": "number", "minimum": 0, "default": 400, "description": "Your personal weekly planning target; not a Copilot plan allowance." },
        "copilotPulse.budgets.billingCycle": { "type": "number", "minimum": 0, "default": 1500, "description": "Your personal cycle planning target; not a Copilot plan allowance." },
        "copilotPulse.budgets.officialAllowance": { "type": "number", "minimum": 0, "default": 0, "description": "Official included allowance, displayed separately from personal targets." },
        "copilotPulse.budgets.officialBudget": { "type": "number", "minimum": 0, "default": 0, "description": "Official enforced budget, if known." },
        "copilotPulse.thresholds.informational": { "type": "number", "minimum": 1, "maximum": 100, "default": 60 },
        "copilotPulse.thresholds.warning": { "type": "number", "minimum": 1, "maximum": 100, "default": 80 },
        "copilotPulse.thresholds.critical": { "type": "number", "minimum": 1, "maximum": 100, "default": 100 },
        "copilotPulse.statusBar.mode": { "type": "string", "enum": ["adaptive", "state", "burnRate", "runway", "budget"], "default": "adaptive" },
        "copilotPulse.notifications.level": { "type": "string", "enum": ["ambient", "information", "actionable"], "default": "actionable" },
        "copilotPulse.spike.enabled": { "type": "boolean", "default": true },
        "copilotPulse.spike.windowMinutes": { "type": "number", "minimum": 5, "default": 30 },
        "copilotPulse.spike.multiplier": { "type": "number", "minimum": 1, "default": 2.5 },
        "copilotPulse.spike.minimumCredits": { "type": "number", "minimum": 1, "default": 10 },
        "copilotPulse.spike.minimumSamples": { "type": "number", "minimum": 3, "default": 8 },
        "copilotPulse.spike.cooldownMinutes": { "type": "number", "minimum": 1, "default": 60 },
        "copilotPulse.forecast.enabled": { "type": "boolean", "default": true },
        "copilotPulse.forecast.warningPercentage": { "type": "number", "minimum": 100, "default": 110 },
        "copilotPulse.forecast.minimumConfidence": { "type": "string", "enum": ["low", "medium", "high"], "default": "medium" },
        "copilotPulse.workingSchedule.days": { "type": "array", "default": [1,2,3,4,5], "items": { "type": "number", "minimum": 0, "maximum": 6 } },
        "copilotPulse.workingSchedule.start": { "type": "string", "default": "09:00", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "copilotPulse.workingSchedule.end": { "type": "string", "default": "17:30", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "copilotPulse.notifications.quietHours.enabled": { "type": "boolean", "default": false },
        "copilotPulse.notifications.quietHours.start": { "type": "string", "default": "18:00" },
        "copilotPulse.notifications.quietHours.end": { "type": "string", "default": "08:00" },
        "copilotPulse.providers.organization": { "type": "string", "default": "", "description": "GitHub organization for authorized Copilot usage reports." },
        "copilotPulse.providers.enterprise": { "type": "string", "default": "", "description": "GitHub enterprise slug for authorized Copilot usage reports." },
        "copilotPulse.storage.retentionDays": { "type": "number", "enum": [30, 90, 180, 365, 0], "default": 180 },
        "copilotPulse.workspaceAware": { "type": "boolean", "default": false },
        "copilotPulse.telemetry.enabled": { "type": "boolean", "default": false }
      }
    }
  },
  "scripts": { "compile": "tsc -p .", "watch": "tsc -w -p .", "test": "vitest run", "lint": "tsc --noEmit", "package": "npm run compile && npx @vscode/vsce package --no-dependencies" },
  "devDependencies": { "@types/node": "^22.10.1", "@types/vscode": "^1.96.0", "@vscode/vsce": "^3.2.1", "typescript": "^5.7.2", "vitest": "^2.1.8" }
}
